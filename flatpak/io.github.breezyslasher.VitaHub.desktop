[Desktop Entry]
Type=Application
Name=VitaHub
Comment=Plex, Audiobookshelf, Suwayomi and Music Assistant in one app
Exec=VitaHub
Icon=io.github.breezyslasher.VitaHub
Terminal=false
Categories=AudioVideo;Video;Audio;Player;Network;
Keywords=Plex;Media;Video;Streaming;Audiobookshelf;Audiobooks;Podcasts;Manga;Suwayomi;Music;
# Ties the window to this launcher. GLFW sets the WM_CLASS class part from the
# window title when the class hints are left empty, and the title is "VitaHub"
# (src/main.cpp) — without this line the shell cannot match the window to
# io.github.breezyslasher.VitaHub.desktop, so it shows a generic icon and does
# not group the window under the launcher.
StartupWMClass=VitaHub
# Registers VitaHub as the handler for Plex and Suwayomi links. The app already knows what
# to do with one (MainActivity::consumeDeepLink); this is what makes a browser
# offer it.
MimeType=x-scheme-handler/plex;x-scheme-handler/vitaplex;x-scheme-handler/vitasuwayomi;
